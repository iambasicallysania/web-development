// Boolean in JavaScript 🔵

// Boolean ek data type hai jisme sirf 2 values hoti hain:

// true
// false
// Example
// let isLoggedIn = true;
// let isAdmin = false;

// Yahan:

// true → yes / correct / on
// false → no / incorrect / off
// Boolean ka use kahan hota hai?

// Mostly conditions mein.

// let age = 23;

// console.log(age >= 18);

// Output:

// true

// Kyuki 23 >= 18 correct hai.

// Similarly:

// let age = 15;

// console.log(age >= 18);

// Output:

// false
// Comparison se Boolean milta hai
// 10 > 5       // true
// 10 < 5       // false
// 10 === 10    // true
// 10 === "10"  // false
